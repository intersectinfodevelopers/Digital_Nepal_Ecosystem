<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>np.gov.digital</groupId>
        <artifactId>digital-nepal-ecosystem</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <dependencies>

        <!-- iText7 — ID card PDF generation -->
    <dependency>
        <groupId>com.itextpdf</groupId>
        <artifactId>itext7-core</artifactId>
        <version>7.2.5</version>
        <type>pom</type>
    </dependency>

    <!-- ZXing — QR code generation -->
    <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>core</artifactId>
        <version>3.5.2</version>
    </dependency>
    <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>javase</artifactId>
        <version>3.5.2</version>
    </dependency>

    <!-- Spring Web — RestTemplate for Sparrow SMS -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Security — @PreAuthorize on endpoints -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Citizen entity/repository — official_document rows are
             always issued to/about a real citizen (V38). This module had
             no persistence at all before; every prior "TODO: save to DB"
             in IdCardController is what this dependency now makes real. -->
        <dependency>
            <groupId>np.gov.digital</groupId>
            <artifactId>citizen-registry-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Audit logging for document issuance/revocation. -->
        <dependency>
            <groupId>np.gov.digital</groupId>
            <artifactId>platform-audit</artifactId>
            <version>${project.version}</version>
        </dependency>

    </dependencies>
    <artifactId>platform-idcard</artifactId>
    <packaging>jar</packaging>
    <name>platform-idcard</name>

</project>
